# Template for a LOCAL .env — copy it with:
#   cp env.register.example .env
#
# Used ONLY by the local helper scripts run from your machine:
#   npm run register   (registers the slash commands)
#   npm run brand      (sets the app avatar + About Me)
#   npm run diagnose   (checks token/app/guild wiring)
#
# The deployed Worker never reads this file. It gets its config from
# wrangler.toml [vars] plus two secrets set with `wrangler secret put`
# (DISCORD_TOKEN and DISCORD_PUBLIC_KEY).
#
# Deliberately NOT named `.env.example`: Cloudflare's Deploy button treats a
# file with that exact name as a deploy-time secrets manifest and would prompt
# for these keys as Worker secrets — the wrong set, and missing
# DISCORD_PUBLIC_KEY. The rename opts out of that behavior.

DISCORD_TOKEN=your_bot_token
DISCORD_APPLICATION_ID=your_application_id
DISCORD_GUILD_ID=your_server_id
